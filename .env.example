# ---- Database (Neon free Postgres) ----
# Get this from https://neon.tech after creating a project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- NextAuth (admin login) ----
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- First admin account (used by the seed script) ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# ---- Cloudinary (free image/video/CV uploads) ----
# Get these from https://cloudinary.com dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ---- Email notifications (OPTIONAL, free via Resend) ----
# Leave blank to disable. Nothing breaks if empty.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="noreply@example.com"
